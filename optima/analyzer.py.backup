"""
Optima analyzer: extracts compiler-derived information from C/C++ projects.
"""
import json
import os
import subprocess
import tempfile
import sys
from pathlib import Path
from typing import List, Dict, Any, Optional, Set
import clang.cindex
from clang.cindex import CursorKind, TypeKind, StorageClass

# Configure clang library path
clang.cindex.Config.set_library_file('/usr/lib/libclang.so.22.1.8')


class FunctionInfo:
    def __init__(self, cursor: clang.cindex.Cursor, file_path: str, project_root: str):
        self.cursor = cursor
        self.file_path = file_path
        self.project_root = project_root
        self.relative_path = os.path.relpath(file_path, project_root)
        self.qualified_name = self._get_qualified_name()
        self.name = cursor.spelling
        self.id = self._generate_id()
        self.return_type = self._get_return_type()
        self.parameters = self._get_parameters()
        self.source_location = self._get_source_location()
        self.source_code = self._get_source_code()
        self.llvm_ir = self._get_llvm_ir()
        self.ast = self._get_ast()
        self.basic_blocks = []  # To be filled by CFG generation
        self.cfg = {"entry_node": "", "exit_node": "", "nodes": [], "edges": []}
        print("DEBUG: setting basic_blocks:", self.basic_blocks)
        print("DEBUG: setting cfg:", self.cfg)
        self.calls = []  # List of function IDs called
        self.called_by = []  # To be filled later
        self.dependencies = []  # List of dependencies (function, class, global, external)
        self._build_cfg()

    def _generate_id(self) -> str:
        # <relative_path>::<qualified_function_name>::<start_line>
        start_line = self.cursor.location.line
        return f"{self.relative_path}::{self.qualified_name}::{start_line}"

    def _get_qualified_name(self) -> str:
        # Get the qualified name by traversing the semantic parent
        name_parts = []
        cursor = self.cursor
        while cursor:
            if cursor.kind in (CursorKind.FUNCTION_DECL,
                               CursorKind.CONSTRUCTOR, CursorKind.DESTRUCTOR,
                               CursorKind.CLASS_DECL, CursorKind.STRUCT_DECL,
                               CursorKind.UNION_DECL, CursorKind.NAMESPACE,
                               CursorKind.TYPEDEF_DECL, CursorKind.ENUM_DECL):
                if cursor.spelling:
                    name_parts.insert(0, cursor.spelling)
            cursor = cursor.semantic_parent
        return "::".join(name_parts)

    def _get_return_type(self) -> str:
        return self.cursor.result_type.spelling

    def _get_parameters(self) -> List[Dict[str, str]]:
        params = []
        for arg in self.cursor.get_arguments():
            params.append({
                "name": arg.spelling,
                "type": arg.type.spelling
            })
        return params

    def _get_source_location(self) -> Dict[str, Any]:
        start = self.cursor.location
        end = self.cursor.extent.end
        return {
            "file": self.cursor.location.file.name if self.cursor.location.file else "",
            "start_line": start.line,
            "start_column": start.column,
            "end_line": end.line,
            "end_column": end.column
        }

    def _get_source_code(self) -> str:
        if not self.cursor.location.file:
            return ""
        with open(self.cursor.location.file.name, 'r') as f:
            lines = f.readlines()
        start_line = self.cursor.location.line - 1  # 0-indexed
        end_line = self.cursor.extent.end.line - 1
        return ''.join(lines[start_line:end_line+1])

    def _get_llvm_ir(self) -> str:
        # For simplicity, we'll generate LLVM IR for the entire file and return it.
        # In a more advanced version, we could extract per-function IR.
        # We'll cache the IR per file to avoid recompiling.
        if not hasattr(self, '_file_llvm_ir'):
            self._file_llvm_ir = self._compile_file_to_llvm_ir()
        return self._file_llvm_ir

    def _compile_file_to_llvm_ir(self) -> str:
        # Use clang to emit LLVM IR for the file
        cmd = [
            'clang',
            '-S',
            '-emit-llvm',
            '-O0',
            self.file_path,
            '-o', '-'
        ]
        try:
            result = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
            if result.returncode != 0:
                print(f"Warning: Failed to compile {self.file_path} to LLVM IR: {result.stderr}", file=sys.stderr)
                return ""
            return result.stdout
        except subprocess.TimeoutExpired:
            print(f"Warning: Timeout compiling {self.file_path} to LLVM IR", file=sys.stderr)
            return ""
        except Exception as e:
            print(f"Warning: Exception compiling {self.file_path} to LLVM IR: {e}", file=sys.stderr)
            return ""

    def _get_ast(self) -> Dict[str, Any]:
        # Return a simplified AST representation for the function
        return self._cursor_to_dict(self.cursor)

    def _cursor_to_dict(self, cursor: clang.cindex.Cursor) -> Dict[str, Any]:
        """Convert a cursor and its children to a simple dict representation."""
        node = {
            "kind": cursor.kind.name,
            "spelling": cursor.spelling,
            "displayname": cursor.displayname,
            "location": {
                "file": cursor.location.file.name if cursor.location.file else None,
                "line": cursor.location.line,
                "column": cursor.location.column
            } if cursor.location.file else None,
            "children": []
        }
        for child in cursor.get_children():
            node["children"].append(self._cursor_to_dict(child))
        return node

    def to_dict(self) -> Dict[str, Any]:
        return {
            "id": self.id,
            "name": self.name,
            "qualified_name": self.qualified_name,
            "return_type": self.return_type,
            "parameters": self.parameters,
            "source_location": self.source_location,
            "source_code": self.source_code,
            "llvm_ir": self.llvm_ir,
            "ast": self.ast,
            "basic_blocks": self.basic_blocks,
            "cfg": self.cfg,
            "calls": self.calls,
            "called_by": self.called_by,
            "dependencies": self.dependencies
        }


    def _build_cfg(self):
        """Build control-flow graph from LLVM IR."""
        # Parse the LLVM IR to extract basic blocks and edges for this function.
        llvm_ir = self._get_llvm_ir()
        if not llvm_ir:
            self.basic_blocks = []
            self.cfg = {
                "entry_node": "",
                "exit_node": "",
                "nodes": [],
                "edges": []
            }
            return
        # Find the function definition in the LLVM IR by mangled name.
        mangled = self.cursor.mangled_name
        # Look for: define ... @<mangled>
        import re
        # Pattern to match the function definition line.
        pattern = r'define[^{]+@' + re.escape(mangled) + r'\s*\([^)]*\s*\)[^{]*\{'
        match = re.search(pattern, llvm_ir, re.DOTALL)
        if not match:
            # Fallback: try without the leading underscore? (should not happen)
            self.basic_blocks = []
            self.cfg = {
                "entry_node": "",
                "exit_node": "",
                "nodes": [],
                "edges": []
            }
            return
        # Extract the function body (from the opening brace to the matching closing brace).
        # We'll do a simple brace matching.
        start_pos = match.end()
        brace_count = 1
        pos = start_pos
        while pos < len(llvm_ir) and brace_count > 0:
            ch = llvm_ir[pos]
            if ch == '{':
                brace_count += 1
            elif ch == '}':
                brace_count -= 1
            pos += 1
        if brace_count != 0:
            # Malformed
            self.basic_blocks = []
            self.cfg = {
                "entry_node": "",
                "exit_node": "",
                "nodes": [],
                "edges": []
            }
            return
        func_body = llvm_ir[start_pos:pos-1]
        # Now parse the function body to extract basic blocks and edges.
        # We'll look for block labels and terminator instructions.
        # Each block starts with a label (e.g., "9:") and ends with a terminator (br, ret, etc.).
        lines_in_body = func_body.split('\n')
        blocks = []  # each element is (label, [instructions])
        current_label = "__entry"  # dummy label for the first block
        current_insts = []
        for line in lines_in_body:
            stripped = line.strip()
            if not stripped:
                continue
            # Check for label: contains a colon and the part before colon is not empty and does not contain '='
            if ':' in stripped:
                before_colon = stripped.split(':', 1)[0].strip()
                if before_colon and '=' not in before_colon:
                    # It's a label
                    label = before_colon
                    # If we already have a label, save the previous block.
                    if current_label is not None:
                        blocks.append((current_label, current_insts))
                    current_label = label
                    current_insts = []
                else:
                    current_insts.append(stripped)
            else:
                current_insts.append(stripped)
        # Don't forget the last block
        if current_label is not None or current_insts:
            blocks.append((current_label, current_insts))
        # Rename the dummy label to "entry"
        # We'll change the label of the first block if it is "__entry"
        if blocks and blocks[0][0] == "__entry":
            # Change the label of the first block to "entry"
            label, insts = blocks[0]
            blocks[0] = ("entry", insts)
        # Now we have the blocks, we need to extract edges from terminator instructions.
        # We'll map from label to index.
        label_to_idx = {label: idx for idx, (label, _) in enumerate(blocks)}
        edges = []
        for idx, (label, insts) in enumerate(blocks):
            # Look at the last instruction in the block (if any) that is a terminator.
            terminator = None
            for inst in reversed(insts):
                if inst.startswith('br ') or inst.startswith('ret ') or inst.startswith('switch ') or inst.startswith('invoke ') or inst.startswith('unwind ') or inst.startswith('unreachable'):
                    terminator = inst
                    break
            if terminator is None:
                # No terminator, assume fall-through to next block if exists.
                if idx + 1 < len(blocks):
                    edges.append([label, blocks[idx+1][0]])
            else:
                if terminator.startswith('ret '):
                    # Return: no outgoing edge (or edge to exit node). We'll not add an edge.
                    pass
                elif terminator.startswith('br '):
                    # Conditional or unconditional branch.
                    # Example: "br i1 %8, label %9, label %11"
                    # or "br label %13"
                    parts = terminator.split()
                    if len(parts) == 3 and parts[1] == 'label':
                        # Unconditional branch
                        target = parts[2]
                        if target.startswith('%'):
                            target = target[1:]
                        edges.append([label, target])
                    elif len(parts) == 5 and parts[2] == 'label' and parts[4] == 'label':
                        # Conditional branch
                        target1 = parts[3]
                        target2 = parts[5]
                        if target1.startswith('%'):
                            target1 = target1[1:]
                        if target2.startswith('%'):
                            target2 = target2[1:]
                        edges.append([label, target1])
                        edges.append([label, target2])
                    else:
                        # We don't know, skip.
                        pass
                # For simplicity, we ignore other terminators.
        # Remove leading '%' from edge targets if present (should already be handled, but just in case)
        for edge in edges:
            if len(edge) == 2 and edge[1].startswith('%'):
                edge[1] = edge[1][1:]
        # The entry node is the first block's label.
        entry_node = blocks[0][0] if blocks else ""
        # The exit node: we'll define it as the block that contains a return instruction.
        # If there are multiple returns, we'll pick the last one.
        exit_node = ""
        for label, insts in reversed(blocks):
            for inst in insts:
                if inst.startswith('ret '):
                    exit_node = label
                    break
            if exit_node:
                break
        if not exit_node and blocks:
            # If no return found, use the last block.
            exit_node = blocks[-1][0]
        self.basic_blocks = [label for label, _ in blocks]
        self.cfg = {
            "entry_node": entry_node,
            "exit_node": exit_node,
            "nodes": self.basic_blocks,
            "edges": edges
        }
def analyze_project(project_path: Path, output_dir: Path) -> Path:
    """Analyze a C/C++ project and generate base.json."""
    project_path = project_path.resolve()
    output_dir = output_dir.resolve()
    output_dir.mkdir(parents=True, exist_ok=True)

    index = clang.cindex.Index.create()

    # Find all relevant files
    extensions = {'.c', '.cpp', '.h', '.hpp'}
    source_files = []
    for root, dirs, files in os.walk(project_path):
        for file in files:
            if Path(file).suffix in extensions:
                source_files.append(Path(root) / file)

    # We'll store all functions and files
    all_files = []
    all_functions = []  # Flat list of all functions for call graph
    function_map = {}  # Map from function ID to FunctionInfo

    for file_path in source_files:
        print(f"Parsing {file_path}")
        try:
            tu = index.parse(str(file_path), args=['-std=c++11'])
        except Exception as e:
            print(f"Error parsing {file_path}: {e}", file=sys.stderr)
            continue

        if tu.diagnostics:
            for diag in tu.diagnostics:
                print(f"Diagnostic: {diag}", file=sys.stderr)

        # Collect functions from this translation unit
        file_functions = []

        def visit_cursor(cursor: clang.cindex.Cursor, parent: Optional[clang.cindex.Cursor] = None):
            if cursor.kind in (CursorKind.FUNCTION_DECL,
                               CursorKind.CONSTRUCTOR, CursorKind.DESTRUCTOR):
                # Only consider definitions, not just declarations
                if cursor.is_definition():
                    func_info = FunctionInfo(cursor, str(file_path), str(project_path))
                    file_functions.append(func_info)
                    all_functions.append(func_info)
                    function_map[func_info.id] = func_info
            # Recurse
            for child in cursor.get_children():
                visit_cursor(child, cursor)

        visit_cursor(tu.cursor)

        # After collecting functions, we can compute calls and dependencies
        for func in file_functions:
            func.calls = _extract_calls(func.cursor, function_map, str(project_path))
            func.dependencies = _extract_dependencies(func.cursor, project_path)

        # File info
        file_info = {
            "id": f"file::{func.relative_path}",
            "name": file_path.name,
            "relative_path": str(func.relative_path),
            "language": "cpp" if file_path.suffix in {'.cpp', '.hpp'} else "c",
            "functions": [f.to_dict() for f in file_functions]
        }
        all_files.append(file_info)

    # Build call graph (project-level)
    call_graph_nodes = []
    call_graph_edges = []
    for func in all_functions:
        call_graph_nodes.append({"id": func.id, "name": func.name, "qualified_name": func.qualified_name})
        for called_id in func.calls:
            call_graph_edges.append({"from": func.id, "to": called_id})

    call_graph = {
        "nodes": call_graph_nodes,
        "edges": call_graph_edges
    }

    # Build base.json structure
    base_json = {
        "project": {
            "name": project_path.name
        },
        "files": all_files,
        "call_graph": call_graph
    }

    output_file = output_dir / "base.json"
    with open(output_file, 'w') as f:
        json.dump(base_json, f, indent=2)

    return output_file


def _extract_calls(cursor: clang.cindex.Cursor, function_map: Dict[str, FunctionInfo], project_path: str) -> List[str]:
    """Extract function calls from the given cursor."""
    calls = []
    for child in cursor.get_children():
        if child.kind == CursorKind.CALL_EXPR:
            # Get the called function
            called_ref = child.get_definition()
            if called_ref and called_ref.kind in (CursorKind.FUNCTION_DECL,
                                                 CursorKind.CONSTRUCTOR, CursorKind.DESTRUCTOR):
                if called_ref.is_definition():
                    # Try to find in our function map
                    # We need to create a FunctionInfo temporarily to get the ID
                    # Alternatively, we can compute the ID from the cursor
                    # Let's create a temporary FunctionInfo to get the ID
                    if called_ref.location.file:
                        temp_func = FunctionInfo(called_ref, called_ref.location.file.name, project_path)
                        if temp_func.id in function_map:
                            calls.append(temp_func.id)
        # Recurse
        calls.extend(_extract_calls(child, function_map, project_path))
    return calls
def _extract_dependencies(cursor: clang.cindex.Cursor, project_path: Path) -> List[str]:
    """Extract dependencies (simplified)."""
    deps = []
    # We'll just look for references to other functions, classes, etc.
    # For now, return an empty list to keep it simple.
    return deps


if __name__ == "__main__":
    # For testing
    import sys
    if len(sys.argv) != 2:
        print("Usage: python analyzer.py <project_path>")
        sys.exit(1)
    project_path = Path(sys.argv[1])
    output_dir = Path("output")
    analyze_project(project_path, output_dir)
    print(f"Analysis complete. Output in {output_dir}")